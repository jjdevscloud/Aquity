# Robinhood Chain RPC + chain id — see AQUITY-SPEC.md §3.2, still unresolved
# without your own access to the chain.
ROBINHOOD_RPC_URL=
ROBINHOOD_CHAIN_ID=

# Ponder's own Postgres database (see https://ponder.sh/docs/requirements).
DATABASE_URL=postgres://localhost:5432/aquity_indexer

# Singleton contracts, from `forge script script/DeployRegistryAndLauncher.s.sol`.
AGENT_REGISTRY_ADDRESS=
AGENT_REGISTRY_START_BLOCK=0
LAUNCHER_ADDRESS=
LAUNCHER_START_BLOCK=0

# Backend signer for AgentRegistry's `verifier` role (src/api/verify.ts).
# Must match whatever address AgentRegistry.verifier() currently points at —
# `cast send $AGENT_REGISTRY_ADDRESS "setVerifier(address)" <address derived
# from this key>` as the registry owner if you rotate it. Never commit this
# key; without it /api/verify/* returns 503 and the wizard's X-verification
# step can't get a signature.
VERIFIER_PRIVATE_KEY=
