# Robinhood Chain RPC + chain id — see AQUITY-SPEC.md §3.2, still unresolved
# without your own access to the chain.
ROBINHOOD_RPC_URL=
ROBINHOOD_CHAIN_ID=

# Ponder's own Postgres database (see https://ponder.sh/docs/requirements).
DATABASE_URL=postgres://localhost:5432/aquity_indexer

# Singleton contracts, from `forge script script/DeployRegistryAndLauncher.s.sol`.
AGENT_REGISTRY_ADDRESS=
AGENT_REGISTRY_START_BLOCK=0
LAUNCHER_ADDRESS=
LAUNCHER_START_BLOCK=0
