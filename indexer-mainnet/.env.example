# Robinhood Chain MAINNET (chain 4663) — real Stock Tokens, real Pons v2
# launchpad, real money. Never point this at the testnet RPC/addresses; use
# /indexer (the sibling project) for those. Deliberately a separate service
# from /indexer so real and demo data never mix in one API response.
ROBINHOOD_MAINNET_RPC_URL=
ROBINHOOD_CHAIN_ID=4663

# Ponder's own Postgres database (see https://ponder.sh/docs/requirements).
DATABASE_URL=postgres://localhost:5432/aquity_indexer_mainnet

# From `forge script script/DeployPonsMainnet.s.sol` (AgentRegistry) and
# `RedeployPonsLauncherMainnet.s.sol` (PonsLauncher, if it's ever
# redeployed against the same registry). START_BLOCK anchors backfill —
# set it to the real deploy block, not 0, or every backfill rescans from
# genesis on a chain with real, deep history.
AGENT_REGISTRY_ADDRESS=0xF7ad702a4FCFAe252BebA256DB63d8e0Fb37EcC7
AGENT_REGISTRY_START_BLOCK=63538274
PONS_LAUNCHER_ADDRESS=0xaD55798b3C1DE63c3ad5e7ba3ED3600A098348a0
PONS_LAUNCHER_START_BLOCK=63548407

# Real Pons v2 factory (github.com/ponsmcp/pons-mcp) — used for live reads
# (e.g. curve reserves/price), not indexed as our own contract.
PONS_FACTORY_ADDRESS=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e

# Backend signer for AgentRegistry's `verifier` role (src/api/verify.ts) —
# same mechanism as /indexer, but this MUST be a different, mainnet-only
# key. Never reuse the testnet verifier key here. Without it /api/verify/*
# returns 503 and the wizard's X-verification step can't get a signature.
VERIFIER_PRIVATE_KEY=
